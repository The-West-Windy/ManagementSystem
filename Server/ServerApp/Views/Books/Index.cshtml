@model IEnumerable<ServerApp.Models.Book>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Books";
}

<h2>Books</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add New Book</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td>@book.Status</td>
                <td>
                    <a class="btn btn-sm btn-info" href="@Url.Action("Edit", new { id = book.ID })">Edit</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = book.ID })">Delete</a>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Details", new { id = book.ID })">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
