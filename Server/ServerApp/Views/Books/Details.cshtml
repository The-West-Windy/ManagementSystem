@model ServerApp.Models.Book

@{
    Layout = "_Layout";
    ViewData["Title"] = "Book Details";
}

<h2>Book Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Model.Title</h5>
        <p class="card-text"><strong>Author:</strong> @Model.Author</p>
        <p class="card-text"><strong>Status:</strong> @Model.Status</p>
    </div>
</div>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to list</a>
