@model IEnumerable<ServerApp.Models.Librarian>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Librarians";
}

<h2>Librarians</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add New Librarian</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var librarian in Model)
        {
            <tr>
                <td>@librarian.Name</td>
                <td>@librarian.Email</td>
                <td>
                    <a class="btn btn-sm btn-info" href="@Url.Action("Edit", new { id = librarian.ID })">Edit</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = librarian.ID })">Delete</a>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Details", new { id = librarian.ID })">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
