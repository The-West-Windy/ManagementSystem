@model ServerApp.Models.BorrowRequest

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Borrow Request";
}

<h2>Edit Borrow Request</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />

    <div class="mb-3">
        <label asp-for="LibrarianID" class="form-label">Librarian</label>
        <select asp-for="LibrarianID" class="form-select" asp-items="ViewBag.Librarians"></select>
        <span asp-validation-for="LibrarianID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BookID" class="form-label">Book</label>
        <select asp-for="BookID" class="form-select" asp-items="ViewBag.Books"></select>
        <span asp-validation-for="BookID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option>Pending</option>
            <option>Approved</option>
            <option>Rejected</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="RequestDate" class="form-label"></label>
        <input asp-for="RequestDate" type="date" class="form-control" />
        <span asp-validation-for="RequestDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
