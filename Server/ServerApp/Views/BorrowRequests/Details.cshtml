@model ServerApp.Models.BorrowRequest

@{
    Layout = "_Layout";
    ViewData["Title"] = "Borrow Request Details";
}

<h2>Borrow Request Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Librarian:</strong> @Model.Librarian?.Name</p>
        <p><strong>Book:</strong> @Model.Book?.Title</p>
        <p><strong>Borrower:</strong> @Model.BorrowerName</p>
        <p><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</p>
        <p><strong>Request Date:</strong> @Model.RequestDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Status:</strong> @Model.Status</p>
    </div>
</div>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to list</a>
