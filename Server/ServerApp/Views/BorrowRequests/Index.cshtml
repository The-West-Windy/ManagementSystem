@model IEnumerable<ServerApp.Models.BorrowRequest>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Borrow Requests";
}

<h2>Borrow Requests</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add New Borrow Request</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Librarian</th>
            <th>Book</th>
            <th>Borrower</th>
            <th>Notes</th>
            <th>Request Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.Librarian?.Name</td>
                <td>@request.Book?.Title</td>
                <td>@request.BorrowerName</td>
                <td>@(string.IsNullOrWhiteSpace(request.Notes) ? "—" : request.Notes)</td>
                <td>@request.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>@request.Status</td>
                <td>
                    <a class="btn btn-sm btn-info" href="@Url.Action("Edit", new { id = request.ID })">Edit</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = request.ID })">Delete</a>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("Details", new { id = request.ID })">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
