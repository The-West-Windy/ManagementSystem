@model ServerApp.Models.TrainingClass

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Class";
}

<h2>Delete Class</h2>

<h4>Are you sure you want to delete this class?</h4>
<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Coach</dt>
    <dd class="col-sm-9">@Model.Coach?.Name</dd>

    <dt class="col-sm-3">Time Slot</dt>
    <dd class="col-sm-9">@Model.TimeSlot</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>
