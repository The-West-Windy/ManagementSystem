@model IEnumerable<ServerApp.Models.TrainingClass>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Classes";
}

<h2>Classes</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add New Class</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Coach</th>
            <th>Time Slot</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Coach?.Name</td>
            <td>@item.TimeSlot</td>
            <td>
                <a class="btn btn-sm btn-info" href="@Url.Action("Details", new { id = item.ID })">Details</a>
                <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = item.ID })">Edit</a>
                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", new { id = item.ID })">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
