@model ServerApp.Models.Booking

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Booking";
}

<h2>Delete Booking</h2>

<h4>Are you sure you want to delete this booking?</h4>
<dl class="row">
    <dt class="col-sm-3">Class</dt>
    <dd class="col-sm-9">@Model.Class?.Name</dd>

    <dt class="col-sm-3">Coach</dt>
    <dd class="col-sm-9">@Model.Coach?.Name</dd>

    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.ClientName</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancel</a>
</form>
