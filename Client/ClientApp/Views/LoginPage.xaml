<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="ClientApp.Views.LoginPage"
             Title="Вхід до бібліотеки">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Ласкаво просимо" FontSize="24" FontAttributes="Bold" />
            <Label Text="Увійдіть як бібліотекар, щоб керувати каталогом книг" />

            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />
            <Entry Placeholder="Пароль" IsPassword="True" Text="{Binding Password}" />

            <Button Text="Увійти" Command="{Binding SignInCommand}" />
            <Label TextColor="Gray" FontAttributes="Italic" Text="{Binding StatusMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
