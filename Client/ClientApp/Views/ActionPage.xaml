<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.ActionPage"
             x:DataType="viewModels:ActionViewModel"
             Title="Booking">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Create Booking" Style="{StaticResource Headline}" />
            <Label Text="Reserve a spot in the selected class." Style="{StaticResource SubHeadline}" />

            <Entry Placeholder="Class name" Text="{Binding ClassName}" IsReadOnly="True" />
            <Entry Placeholder="Coach" Text="{Binding CoachName}" IsReadOnly="True" />
            <Entry Placeholder="Time slot" Text="{Binding TimeSlot}" IsReadOnly="True" />
            <Entry Placeholder="Client name" Text="{Binding ClientName}" />
            <Editor Placeholder="Notes" HeightRequest="120" Text="{Binding Notes}" />

            <Button Text="Submit" Command="{Binding SubmitCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
